module

public import AlgebraicDirectLimits.Topology.TensorSeparation
public import Mathlib.LinearAlgebra.Finsupp.VectorSpace
public import Mathlib.LinearAlgebra.TensorProduct.Associator
public import Mathlib.RingTheory.Finiteness.Cardinality
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.Topology.Algebra.Group.ZPow
public import Mathlib.Topology.Algebra.Ring.Real
public import Mathlib.Topology.Order.DenselyOrdered
public import Mathlib.Tactic.NormNum

/-!
# Infinite-basis and nonfree-projective tensor separation examples

The canonical basis of `ℕ →₀ ℤ` gives coefficients that are free and projective
but not finitely generated. The right factor is `ℝ` with its usual nondiscrete
Hausdorff topology and canonical jointly continuous integer action. Product
coordinates detect a nonzero pure tensor and two mixed tensors with coordinate
pairs `(1, 2)` and `(2, 1)`. Pullbacks of disjoint open real intervals separate
the mixed tensors explicitly.

A second coefficient module is the canonical ideal generated by `(1, 0)` in
`ℤ × ℤ`. Right multiplication by this idempotent retracts the regular module
onto the ideal. The nonzero scalar `(0, 1)` annihilates the entire ideal, so
nontriviality and faithful action of free modules show that it is not free.
The right module is the discrete regular module. The algebraic right tensor
unit detects a nonzero pure tensor; an outgoing continuous lift supplies
explicit disjoint open neighborhoods. No topology is placed on the ideal.

The supplied-basis and projective statements give Hausdorffness of these tensor models.
The coordinate calculations,
model properties and explicit open-set calculations do not use those statements.

## References

These applications follow Lantern's arbitrary-coordinate and split-cover
mathematics. The one-sided tensor topology follows the Continuous Group Cohomology
work by Formal Frontier Agents, including Beacon's original development, and
Mathlib's topological modules by Richard Hill and Andrew Yang. Projective splitting
is Mathlib's API by Kevin Buzzard and Antoine Labelle; basis and Finsupp APIs are
due to Johannes Hölzl, Kim Morrison, Mario Carneiro and Alexander Bentkamp, and
tensor-basis coordinates to Jakob von Raumer. The finiteness provider is due to
Johan Commelin. Dense-order topology is due to Johannes Hölzl, Mario Carneiro and
Yury Kudryashov; integer-action continuity to Johannes Hölzl, Mario Carneiro and
Patrick Massot. The ideal API is due to Kenny Lau, Chris Hughes and Mario Carneiro,
and the algebraic tensor unit to Kenny Lau and Mario Carneiro. The continuous
linear API authors are credited in `Topology.TensorHom`. Projective Modules by
Formal Frontier Agents, including Prism's work, provides related general
idempotent-ideal mathematics; only fixed concrete model data are constructed here.
-/

@[expose] public section

open scoped TensorProduct

universe uR uC uM uN uI

namespace ProjectiveTensorSeparationExamples

/-- Countably infinite free integer coefficients with the canonical Finsupp action. -/
noncomputable abbrev infiniteCoefficients : ModuleCat ℤ := ModuleCat.of ℤ (ℕ →₀ ℤ)

/-- The canonical single-one basis of the coefficient module. -/
noncomputable def infiniteBasis : Module.Basis ℕ ℤ infiniteCoefficients :=
  Finsupp.basisSingleOne

/-- The coefficient basis vector supported at `n`. -/
noncomputable def integerBasisVector (n : ℕ) : infiniteCoefficients := Finsupp.single n 1

/-- These coefficients have the stock free-module dictionary. -/
theorem infiniteCoefficients_free : Module.Free ℤ infiniteCoefficients := by
  infer_instance

/-- Stock free-to-projective inference supplies the projective dictionary. -/
theorem infiniteCoefficients_projective : Module.Projective ℤ infiniteCoefficients := by
  letI : Module.Free ℤ infiniteCoefficients := infiniteCoefficients_free
  infer_instance

/-- The infinite canonical basis rules out finite generation, by Mathlib's stock result. -/
theorem infiniteCoefficients_not_finite : ¬ Module.Finite ℤ infiniteCoefficients :=
  Module.not_finite_of_infinite_basis infiniteBasis

/-- The reals with the usual topology and canonical integer action. -/
abbrev realModule : TopModuleCat ℤ := TopModuleCat.of ℤ ℝ

/-- The supplied right topology is Hausdorff. -/
theorem realModule_t2 : T2Space realModule := by
  infer_instance

/-- The usual dense-order topology of the reals is not discrete. -/
theorem realModule_not_discrete : ¬ DiscreteTopology realModule := by
  intro h
  letI : DiscreteTopology ℝ := h
  letI : Subsingleton ℝ := DenselyOrdered.subsingleton_of_discreteTopology
  exact (zero_ne_one : (0 : ℝ) ≠ 1) (Subsingleton.elim _ _)

/-- The one-sided tensor of infinite integer coefficients with the usual reals. -/
noncomputable abbrev infiniteTensor : TopModuleCat ℤ :=
  TopModuleCat.tensorLeftObj ℤ infiniteCoefficients realModule

/-- The arbitrary product-coordinate map for the infinite model. -/
noncomputable def infiniteCoordinates : infiniteTensor →L[ℤ] (ℕ → realModule) :=
  TopModuleCat.tensorCoordinatesCLM ℤ infiniteCoefficients realModule infiniteBasis

private theorem integerBasisVector_eq_basis (n : ℕ) :
    integerBasisVector n = infiniteBasis n := by
  simp [integerBasisVector, infiniteBasis]

/-- A basis pure tensor has its right value at precisely its basis position. -/
theorem infiniteCoordinates_basis_tmul (n i : ℕ) (m : realModule) :
    infiniteCoordinates (integerBasisVector n ⊗ₜ[ℤ] m) i = if n = i then m else 0 := by
  change TopModuleCat.tensorCoordinatesCLM ℤ infiniteCoefficients realModule infiniteBasis
    (integerBasisVector n ⊗ₜ[ℤ] m) i = _
  rw [integerBasisVector_eq_basis,
    TopModuleCat.tensorCoordinatesCLM_tmul_apply, Module.Basis.repr_self_apply]
  by_cases h : n = i <;> simp [h]

/-- The generator-coordinate API gives value `1` at the first basis generator. -/
theorem infiniteCoordinates_first_generator :
    infiniteCoordinates
      (TopModuleCat.tensorGenerator ℤ infiniteCoefficients realModule (integerBasisVector 0) 1)
      0 = 1 := by
  change TopModuleCat.tensorCoordinatesCLM ℤ infiniteCoefficients realModule infiniteBasis
    (TopModuleCat.tensorGenerator ℤ infiniteCoefficients realModule (integerBasisVector 0) 1)
      0 = 1
  rw [integerBasisVector_eq_basis,
    TopModuleCat.tensorCoordinatesCLM_tensorGenerator_apply]
  simp

/-- The underlying-coordinate bridge applies on every tensor in the infinite model. -/
theorem infiniteCoordinates_finsupp (x : infiniteTensor) :
    infiniteCoordinates x =
      ((TensorProduct.equivFinsuppOfBasisLeft infiniteBasis) x : ℕ → realModule) := by
  exact DFunLike.congr_fun
    (TopModuleCat.tensorCoordinatesCLM_toLinearMap ℤ
      infiniteCoefficients realModule infiniteBasis) x

/-- Product coordinates detect equality in the infinite model. -/
theorem infiniteCoordinates_detects_eq {x y : infiniteTensor}
    (h : infiniteCoordinates x = infiniteCoordinates y) : x = y :=
  TopModuleCat.tensorCoordinatesCLM_injective ℤ infiniteCoefficients realModule infiniteBasis h

/-- The first pure tensor has coefficient `e₀` and right value `1`. -/
noncomputable def infiniteFirstTensor : infiniteTensor :=
  integerBasisVector 0 ⊗ₜ[ℤ] (1 : realModule)

/-- Coordinates detect this pure tensor as nonzero, without tensor Hausdorffness. -/
theorem infiniteFirstTensor_ne_zero : infiniteFirstTensor ≠ 0 := by
  intro h
  have hv : infiniteCoordinates infiniteFirstTensor 0 = 1 :=
    (infiniteCoordinates_basis_tmul 0 0 (1 : realModule)).trans (by norm_num)
  have hz : infiniteCoordinates (0 : infiniteTensor) 0 = (0 : realModule) :=
    congrFun infiniteCoordinates.map_zero 0
  have he : (0 : realModule) = 1 :=
    hz.symm.trans ((congrArg (fun x : infiniteTensor ↦ infiniteCoordinates x 0) h).symm.trans hv)
  exact (zero_ne_one : (0 : ℝ) ≠ 1) he

/-- A mixed tensor with the first two right values `1` and `2`. -/
noncomputable def infiniteMixedX : infiniteTensor :=
  integerBasisVector 0 ⊗ₜ[ℤ] (1 : realModule) +
    integerBasisVector 1 ⊗ₜ[ℤ] (2 : realModule)

/-- The mixed tensor with the first two right values interchanged. -/
noncomputable def infiniteMixedY : infiniteTensor :=
  integerBasisVector 0 ⊗ₜ[ℤ] (2 : realModule) +
    integerBasisVector 1 ⊗ₜ[ℤ] (1 : realModule)

/-- The first two coordinates of the first mixed tensor are `(1, 2)`. -/
theorem infiniteMixedX_coordinates :
    infiniteCoordinates infiniteMixedX 0 = 1 ∧ infiniteCoordinates infiniteMixedX 1 = 2 := by
  have hcoord (i : ℕ) : infiniteCoordinates infiniteMixedX i =
      (if (0 : ℕ) = i then (1 : realModule) else 0) +
        (if (1 : ℕ) = i then (2 : realModule) else 0) :=
    (congrFun (infiniteCoordinates.map_add
      (show infiniteTensor from integerBasisVector 0 ⊗ₜ[ℤ] (1 : realModule))
      (show infiniteTensor from integerBasisVector 1 ⊗ₜ[ℤ] (2 : realModule))) i).trans
        (congrArg₂ (fun x y : realModule ↦ x + y)
          (infiniteCoordinates_basis_tmul 0 i (1 : realModule))
          (infiniteCoordinates_basis_tmul 1 i (2 : realModule)))
  constructor
  · exact (hcoord 0).trans (by norm_num)
  · exact (hcoord 1).trans (by norm_num)

/-- The first two coordinates of the second mixed tensor are `(2, 1)`. -/
theorem infiniteMixedY_coordinates :
    infiniteCoordinates infiniteMixedY 0 = 2 ∧ infiniteCoordinates infiniteMixedY 1 = 1 := by
  have hcoord (i : ℕ) : infiniteCoordinates infiniteMixedY i =
      (if (0 : ℕ) = i then (2 : realModule) else 0) +
        (if (1 : ℕ) = i then (1 : realModule) else 0) :=
    (congrFun (infiniteCoordinates.map_add
      (show infiniteTensor from integerBasisVector 0 ⊗ₜ[ℤ] (2 : realModule))
      (show infiniteTensor from integerBasisVector 1 ⊗ₜ[ℤ] (1 : realModule))) i).trans
        (congrArg₂ (fun x y : realModule ↦ x + y)
          (infiniteCoordinates_basis_tmul 0 i (2 : realModule))
          (infiniteCoordinates_basis_tmul 1 i (1 : realModule)))
  constructor
  · exact (hcoord 0).trans (by norm_num)
  · exact (hcoord 1).trans (by norm_num)

/-- The exhibited mixed tensors are distinct. -/
theorem infiniteMixedX_ne_mixedY : infiniteMixedX ≠ infiniteMixedY := by
  intro h
  have hv := infiniteMixedX_coordinates.1
  rw [h, infiniteMixedY_coordinates.1] at hv
  norm_num at hv

/-- The first-coordinate pullback of `(1/2, 3/2)`. -/
noncomputable def leftIntervalPreimage : Set infiniteTensor :=
  (fun x : infiniteTensor ↦ infiniteCoordinates x 0) ⁻¹' Set.Ioo (1 / 2 : ℝ) (3 / 2)

/-- The first-coordinate pullback of `(3/2, 5/2)`. -/
noncomputable def rightIntervalPreimage : Set infiniteTensor :=
  (fun x : infiniteTensor ↦ infiniteCoordinates x 0) ⁻¹' Set.Ioo (3 / 2 : ℝ) (5 / 2)

/-- Coordinate continuity makes the first interval pullback open. -/
theorem leftIntervalPreimage_isOpen : IsOpen leftIntervalPreimage :=
  isOpen_Ioo.preimage ((continuous_apply 0).comp infiniteCoordinates.continuous)

/-- Coordinate continuity makes the second interval pullback open. -/
theorem rightIntervalPreimage_isOpen : IsOpen rightIntervalPreimage :=
  isOpen_Ioo.preimage ((continuous_apply 0).comp infiniteCoordinates.continuous)

/-- The first mixed tensor belongs to the first interval pullback. -/
theorem infiniteMixedX_mem_left : infiniteMixedX ∈ leftIntervalPreimage := by
  change (1 / 2 : ℝ) < infiniteCoordinates infiniteMixedX 0 ∧
    infiniteCoordinates infiniteMixedX 0 < 3 / 2
  rw [infiniteMixedX_coordinates.1]
  norm_num

/-- The second mixed tensor belongs to the second interval pullback. -/
theorem infiniteMixedY_mem_right : infiniteMixedY ∈ rightIntervalPreimage := by
  change (3 / 2 : ℝ) < infiniteCoordinates infiniteMixedY 0 ∧
    infiniteCoordinates infiniteMixedY 0 < 5 / 2
  rw [infiniteMixedY_coordinates.1]
  norm_num

/-- The interval pullbacks are disjoint, even though the intervals share an excluded endpoint. -/
theorem intervalPreimages_disjoint : Disjoint leftIntervalPreimage rightIntervalPreimage := by
  apply Set.disjoint_left.mpr
  intro x hx hy
  change (1 / 2 : ℝ) < infiniteCoordinates x 0 ∧ infiniteCoordinates x 0 < 3 / 2 at hx
  change (3 / 2 : ℝ) < infiniteCoordinates x 0 ∧ infiniteCoordinates x 0 < 5 / 2 at hy
  exact (not_lt_of_ge hx.2.le) hy.1

/-- Explicit disjoint open neighborhoods separate the two mixed tensors. -/
theorem infiniteMixed_separated_intervals :
    ∃ U V : Set infiniteTensor, IsOpen U ∧ IsOpen V ∧
      infiniteMixedX ∈ U ∧ infiniteMixedY ∈ V ∧ Disjoint U V :=
  ⟨leftIntervalPreimage, rightIntervalPreimage, leftIntervalPreimage_isOpen,
    rightIntervalPreimage_isOpen, infiniteMixedX_mem_left, infiniteMixedY_mem_right,
    intervalPreimages_disjoint⟩

/-- The arbitrary-basis preservation statement applies to these nonfinite coefficients. -/
theorem infiniteTensor_t2_of_basis : T2Space infiniteTensor :=
  TopModuleCat.t2Space_tensorLeftObj_of_basis ℤ infiniteCoefficients realModule infiniteBasis

/-- The projective preservation statement also applies to these infinite coefficients. -/
theorem infiniteTensor_t2_projective : T2Space infiniteTensor := by
  letI : Module.Projective ℤ infiniteCoefficients := infiniteCoefficients_projective
  exact TopModuleCat.t2Space_tensorLeftObj ℤ infiniteCoefficients realModule

/-- The supplied-basis statement separates the exhibited nonzero pure tensor from zero. -/
theorem infiniteFirstTensor_separated_zero :
    ∃ U V : Set infiniteTensor, IsOpen U ∧ IsOpen V ∧
      infiniteFirstTensor ∈ U ∧ 0 ∈ V ∧ Disjoint U V := by
  letI : T2Space infiniteTensor := infiniteTensor_t2_of_basis
  exact t2_separation infiniteFirstTensor_ne_zero

/-- The projective statement separates the exhibited mixed tensors. -/
theorem infiniteMixed_separated_projective :
    ∃ U V : Set infiniteTensor, IsOpen U ∧ IsOpen V ∧
      infiniteMixedX ∈ U ∧ infiniteMixedY ∈ V ∧ Disjoint U V := by
  letI : T2Space infiniteTensor := infiniteTensor_t2_projective
  exact t2_separation infiniteMixedX_ne_mixedY

/-- The discrete product ring with componentwise multiplication. -/
abbrev productRing := ℤ × ℤ

/-- The first-axis idempotent. -/
def firstAxisIdempotent : productRing := (1, 0)

/-- The complementary nonzero scalar. -/
def secondAxisScalar : productRing := (0, 1)

/-- The coefficient ideal, with its canonical ideal module action. -/
def firstAxisIdeal : Ideal productRing := Ideal.span ({firstAxisIdempotent} : Set productRing)

/-- The ideal as a purely algebraic coefficient object. -/
abbrev firstAxisCoefficients : ModuleCat productRing := ModuleCat.of productRing firstAxisIdeal

/-- The ideal generator packaged using singleton-span membership. -/
def firstAxisElement : firstAxisCoefficients :=
  ⟨firstAxisIdempotent, Ideal.mem_span_singleton_self firstAxisIdempotent⟩

/-- The concrete generator is idempotent. -/
theorem firstAxisIdempotent_mul_self : firstAxisIdempotent * firstAxisIdempotent =
    firstAxisIdempotent := by
  ext <;> simp [firstAxisIdempotent]

private theorem firstAxis_second_eq_zero (z : firstAxisCoefficients) :
    (z : productRing).2 = 0 := by
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp z.property
  simpa [firstAxisIdempotent] using (congrArg Prod.snd ha).symm

/-- Right multiplication by the fixed idempotent, restricted to the canonical ideal. -/
noncomputable def firstAxisRetraction : productRing →ₗ[productRing] firstAxisCoefficients :=
  (LinearMap.toSpanSingleton productRing productRing firstAxisIdempotent).codRestrict
    firstAxisIdeal (fun r ↦ Ideal.mem_span_singleton'.mpr ⟨r, rfl⟩)

/-- The concrete multiplication map retracts the stock ideal inclusion. -/
theorem firstAxisRetraction_comp_subtype :
    firstAxisRetraction.comp firstAxisIdeal.subtype = LinearMap.id := by
  apply LinearMap.ext
  intro z
  apply Subtype.ext
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp z.property
  change (z : productRing) * firstAxisIdempotent = (z : productRing)
  rw [← ha, mul_assoc, firstAxisIdempotent_mul_self]

/-- Stock projective split-summand inference supplies this ideal's projective dictionary. -/
theorem firstAxisCoefficients_projective : Module.Projective productRing firstAxisCoefficients :=
  Module.Projective.of_split firstAxisIdeal.subtype firstAxisRetraction
    firstAxisRetraction_comp_subtype

/-- The packaged generator is nonzero in the ideal. -/
theorem firstAxisElement_ne_zero : firstAxisElement ≠ 0 := by
  intro h
  have hv := congrArg (fun z : firstAxisCoefficients ↦ (z : productRing).1) h
  simpa [firstAxisElement, firstAxisIdempotent] using hv

/-- Zero and the packaged generator show that the coefficient module is nontrivial. -/
theorem firstAxisCoefficients_nontrivial : Nontrivial firstAxisCoefficients :=
  ⟨⟨firstAxisElement, 0, firstAxisElement_ne_zero⟩⟩

/-- The complementary scalar is nonzero. -/
theorem secondAxisScalar_ne_zero : secondAxisScalar ≠ 0 := by
  intro h
  have hv := congrArg Prod.snd h
  simpa [secondAxisScalar] using hv

/-- The complementary scalar annihilates every element of the canonical ideal. -/
theorem secondAxisScalar_smul (z : firstAxisCoefficients) : secondAxisScalar • z = 0 := by
  apply Subtype.ext
  change secondAxisScalar * (z : productRing) = 0
  apply Prod.ext
  · simp [secondAxisScalar]
  · simp [secondAxisScalar, firstAxis_second_eq_zero z]

/-- This projective ideal is not free: a nonzero scalar kills the entire nontrivial module. -/
theorem firstAxisCoefficients_not_free : ¬ Module.Free productRing firstAxisCoefficients := by
  intro h
  letI : Module.Free productRing firstAxisCoefficients := h
  letI : Nontrivial firstAxisCoefficients := firstAxisCoefficients_nontrivial
  apply secondAxisScalar_ne_zero
  exact eq_of_smul_eq_smul (α := firstAxisCoefficients) (fun z ↦ by
    rw [secondAxisScalar_smul, zero_smul])

/-- The regular module over the product ring with the stock discrete product topology. -/
abbrev productModule : TopModuleCat productRing := TopModuleCat.of productRing productRing

/-- The regular right module has the discrete product topology. -/
theorem productModule_discrete : DiscreteTopology productModule := by
  infer_instance

/-- The right module is Hausdorff with its supplied topology. -/
theorem productModule_t2 : T2Space productModule := by
  infer_instance

/-- The one-sided tensor with the nonfree projective ideal as coefficients. -/
noncomputable abbrev firstAxisTensorObj : TopModuleCat productRing :=
  TopModuleCat.tensorLeftObj productRing firstAxisCoefficients productModule

/-- The tensor of the packaged ideal generator with the regular-module unit. -/
noncomputable def firstAxisTensor : firstAxisTensorObj :=
  firstAxisElement ⊗ₜ[productRing] (1 : productModule)

/-- The algebraic right tensor unit detects this tensor as the nonzero ideal generator. -/
theorem firstAxisTensor_rid :
    TensorProduct.rid productRing firstAxisCoefficients firstAxisTensor = firstAxisElement := by
  change TensorProduct.rid productRing firstAxisCoefficients
    (firstAxisElement ⊗ₜ[productRing] (1 : productRing)) = firstAxisElement
  rw [TensorProduct.rid_tmul, one_smul]

/-- The pure tensor is nonzero, using only the algebraic unit, not a topology on the ideal. -/
theorem firstAxisTensor_ne_zero : firstAxisTensor ≠ 0 := by
  intro h
  have hraw : (firstAxisElement ⊗ₜ[productRing] (1 : productRing) :
      TensorProduct productRing firstAxisCoefficients productRing) = 0 := h
  have hz : TensorProduct.rid productRing firstAxisCoefficients
      (0 : TensorProduct productRing firstAxisCoefficients productRing) =
        (0 : firstAxisCoefficients) :=
    (TensorProduct.rid productRing firstAxisCoefficients).map_zero
  apply firstAxisElement_ne_zero
  exact firstAxisTensor_rid.symm.trans
    ((congrArg (TensorProduct.rid productRing firstAxisCoefficients) hraw).trans hz)

/-- An outgoing continuous lift of the ideal inclusion times the right identity. -/
noncomputable def firstAxisTensorValue : firstAxisTensorObj →L[productRing] productModule :=
  TopModuleCat.tensorLiftCLM productRing
    (firstAxisIdeal.subtype.smulRight (ContinuousLinearMap.id productRing productModule))

/-- The outgoing continuous map detects the pure tensor with value `(1, 0)`. -/
theorem firstAxisTensorValue_first :
    firstAxisTensorValue firstAxisTensor = firstAxisIdempotent := by
  change TopModuleCat.tensorLiftCLM productRing
    (firstAxisIdeal.subtype.smulRight (ContinuousLinearMap.id productRing productModule))
      (firstAxisElement ⊗ₜ[productRing] (1 : productModule)) = firstAxisIdempotent
  rw [TopModuleCat.tensorLiftCLM_tmul]
  simp [LinearMap.smulRight_apply, firstAxisElement, smul_eq_mul]

/-- Explicit singleton pullbacks are disjoint open neighborhoods in this supplied tensor topology. -/
theorem firstAxisTensor_separated_preimages :
    ∃ U V : Set firstAxisTensorObj, IsOpen U ∧ IsOpen V ∧
      firstAxisTensor ∈ U ∧ 0 ∈ V ∧ Disjoint U V := by
  refine ⟨firstAxisTensorValue ⁻¹' {firstAxisIdempotent}, firstAxisTensorValue ⁻¹' {0},
    (isOpen_discrete _).preimage firstAxisTensorValue.continuous,
    (isOpen_discrete _).preimage firstAxisTensorValue.continuous, ?_, ?_, ?_⟩
  · simpa only [Set.mem_preimage, Set.mem_singleton_iff] using firstAxisTensorValue_first
  · simp only [Set.mem_preimage, Set.mem_singleton_iff, map_zero]
  · apply Set.disjoint_left.mpr
    intro x hx hy
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx hy
    have he : firstAxisIdempotent = 0 := hx.symm.trans hy
    have hv := congrArg Prod.fst he
    simpa [firstAxisIdempotent] using hv

/-- The projective preservation statement applies to the nonfree ideal model. -/
theorem firstAxisTensor_t2 : T2Space firstAxisTensorObj := by
  letI : Module.Projective productRing firstAxisCoefficients := firstAxisCoefficients_projective
  exact TopModuleCat.t2Space_tensorLeftObj productRing firstAxisCoefficients productModule

/-- The projective statement separates the exhibited nonzero ideal tensor from zero. -/
theorem firstAxisTensor_separated_zero :
    ∃ U V : Set firstAxisTensorObj, IsOpen U ∧ IsOpen V ∧
      firstAxisTensor ∈ U ∧ 0 ∈ V ∧ Disjoint U V := by
  letI : T2Space firstAxisTensorObj := firstAxisTensor_t2
  exact t2_separation firstAxisTensor_ne_zero

section IndependentUniverses

variable (R : Type uR) [CommRing R] [TopologicalSpace R]
variable (C : ModuleCat.{uC} R) (M : TopModuleCat.{uM} R) (N : TopModuleCat.{uN} R)
variable {ι : Type uI}

/-- Right-factor maps between independently leveled modules commute with arbitrary
product coordinates. This consumer uses the coordinate and tensor-map characteristic APIs. -/
theorem tensorMap_productCoordinates (b : Module.Basis ι R C) (g : M →L[R] N) :
    (TopModuleCat.tensorCoordinatesCLM R C N b).comp
      (TopModuleCat.tensorMapCLM R (LinearMap.id : C →ₗ[R] C) g) =
        ContinuousLinearMap.pi (fun i : ι ↦ g.comp
          ((ContinuousLinearMap.proj (R := R) (φ := fun _ : ι ↦ M) i).comp
            (TopModuleCat.tensorCoordinatesCLM R C M b))) := by
  let qM : TopModuleCat.tensorLeftObj R C M →L[R] (ι → M) :=
    TopModuleCat.tensorCoordinatesCLM R C M b
  let qN : TopModuleCat.tensorLeftObj R C N →L[R] (ι → N) :=
    TopModuleCat.tensorCoordinatesCLM R C N b
  let t : TopModuleCat.tensorLeftObj R C M →L[R] TopModuleCat.tensorLeftObj R C N :=
    TopModuleCat.tensorMapCLM R (LinearMap.id : C →ₗ[R] C) g
  let f (i : ι) : TopModuleCat.tensorLeftObj R C M →L[R] N :=
    g.comp ((ContinuousLinearMap.proj (R := R) (φ := fun _ : ι ↦ M) i).comp qM)
  apply ContinuousLinearMap.coe_injective
  apply TensorProduct.ext'
  intro c m
  apply funext
  intro i
  let x : TopModuleCat.tensorLeftObj R C M := c ⊗ₜ[R] m
  have hmap : t x = (show TopModuleCat.tensorLeftObj R C N from c ⊗ₜ[R] g m) :=
    TopModuleCat.tensorMapCLM_tmul R (LinearMap.id : C →ₗ[R] C) g c m
  have hright : ContinuousLinearMap.pi f x i = g (qM x i) := by
    calc
      ContinuousLinearMap.pi f x i = f i x := ContinuousLinearMap.pi_apply f x i
      _ = g (((ContinuousLinearMap.proj (R := R) (φ := fun _ : ι ↦ M) i).comp qM) x) :=
        ContinuousLinearMap.comp_apply g
          ((ContinuousLinearMap.proj (R := R) (φ := fun _ : ι ↦ M) i).comp qM) x
      _ = g ((ContinuousLinearMap.proj (R := R) (φ := fun _ : ι ↦ M) i) (qM x)) :=
        congrArg g (ContinuousLinearMap.comp_apply
          (ContinuousLinearMap.proj (R := R) (φ := fun _ : ι ↦ M) i) qM x)
      _ = g (qM x i) := congrArg g
        (ContinuousLinearMap.proj_apply (R := R) (φ := fun _ : ι ↦ M) i (qM x))
  calc
    _ = qN (t x) i := congrFun (ContinuousLinearMap.comp_apply qN t x) i
    _ = qN (c ⊗ₜ[R] g m) i :=
      congrArg (fun y : TopModuleCat.tensorLeftObj R C N ↦ qN y i) hmap
    _ = b.repr c i • g m :=
      TopModuleCat.tensorCoordinatesCLM_tmul_apply R C N b c (g m) i
    _ = g (b.repr c i • m) := (g.map_smul (b.repr c i) m).symm
    _ = g (qM x i) := congrArg g
      (TopModuleCat.tensorCoordinatesCLM_tmul_apply R C M b c m i).symm
    _ = _ := hright.symm

/-- Projective coefficients give open point separation with independent scalar,
coefficient and right-factor universes, without a chosen basis or a tensor T2 premise. -/
theorem projectiveCoefficients_separates_tensor [Module.Projective R C] [T2Space M]
    (x y : TopModuleCat.tensorLeftObj R C M) (hne : x ≠ y) :
    ∃ U V : Set (TopModuleCat.tensorLeftObj R C M),
      IsOpen U ∧ IsOpen V ∧ x ∈ U ∧ y ∈ V ∧ Disjoint U V := by
  letI : T2Space (TopModuleCat.tensorLeftObj R C M) :=
    TopModuleCat.t2Space_tensorLeftObj R C M
  exact t2_separation hne

end IndependentUniverses

end ProjectiveTensorSeparationExamples
