module

public import Mathlib.RingTheory.KrullDimension.Basic
public import Mathlib.RingTheory.Spectrum.Prime.RingHom
public import Mathlib.Algebra.Ring.Subsemiring.Basic
public import Mathlib.Data.Set.Restrict

/-!
# Krull dimension under finite-subset capture

If every finite subset of a commutative semiring is contained in the range of one
homomorphism in a family, its Krull dimension is at most the supremum of the source
dimensions. The sources need not embed in the target or form a directed system.

For a finite strict chain of prime ideals, choose one element witnessing each adjacent
strict inclusion. Capture these elements in a single source. Contraction preserves the
strictness of this particular chain, although it need not preserve strict inclusions globally.
The supremum over all finite strict chains gives the bound, including dimensions `⊥` and `⊤`.

As an application, the dimensions of the subsemirings generated by finite subsets bound
the dimension of the whole semiring. For a subsemiring `A` of the target, restriction to
`A.comap (φ i)` retains finite-subset capture inside `A`; the corresponding dimension
bound uses these preimages, not the dimensions of the ambient sources or target.

## References

The dimension convention, finite-chain API, and prime-ideal contraction API are from
Mathlib's `Order.krullDim`, `LTSeries`, and `PrimeSpectrum.comap`. The singleton-family
specialization recovers Mathlib's `ringKrullDim_le_of_surjective`.
-/

@[expose] public section

universe u v w

/-- The range of the canonical restriction to a subsemiring preimage consists exactly
of the elements whose ambient values lie in the original homomorphism range. -/
theorem RingHom.range_restrict_comap
    {R : Type u} {S : Type v} [NonAssocSemiring R] [NonAssocSemiring S]
    (f : R →+* S) (A : Subsemiring S) :
    Set.range (f.restrict (A.comap f) A (fun _ hx => hx)) =
      Subtype.val ⁻¹' Set.range f := by
  change Set.range ((A : Set S).restrictPreimage f) = _
  exact Set.range_restrictPreimage (A : Set S) f

/-- If every finite subset of a commutative semiring lies in one homomorphism range,
its Krull dimension is bounded by the supremum of the source dimensions.
The index, target, and source-family universes are independent; no injectivity is assumed. -/
theorem ringKrullDim_le_iSup_of_finite_subset_range
    {I : Type u} {B : Type v} [CommSemiring B]
    {A : I → Type w} [∀ i, CommSemiring (A i)]
    (φ : ∀ i, A i →+* B)
    (hfinite : ∀ (E : Set B), E.Finite → ∃ i, E ⊆ Set.range (φ i)) :
    ringKrullDim B ≤ ⨆ i, ringKrullDim (A i) := by
  classical
  change Order.krullDim (PrimeSpectrum B) ≤ _
  refine iSup_le fun p => ?_
  have hwitness (j : Fin p.length) :
      ∃ x ∈ (p j.succ).asIdeal, x ∉ (p j.castSucc).asIdeal :=
    SetLike.exists_of_lt ((PrimeSpectrum.asIdeal_lt_asIdeal _ _).2 (p.step j))
  choose x hxupper hxlower using hwitness
  obtain ⟨i, hi⟩ := hfinite (Set.range x) (Set.finite_range x)
  have hstrict : StrictMono (fun j => PrimeSpectrum.comap (φ i) (p j)) := by
    refine Fin.strictMono_iff_lt_succ.2 fun j => ?_
    obtain ⟨a, ha⟩ := hi (Set.mem_range_self j)
    apply (PrimeSpectrum.asIdeal_lt_asIdeal _ _).1
    rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal]
    refine SetLike.lt_iff_le_and_exists.2 ⟨Ideal.comap_mono (p.step j).le, a, ?_, ?_⟩
    · simpa only [Ideal.mem_comap, ha] using hxupper j
    · simpa only [Ideal.mem_comap, ha] using hxlower j
  let q := LTSeries.mk p.length (fun j => PrimeSpectrum.comap (φ i) (p j)) hstrict
  exact (Order.LTSeries.length_le_krullDim q).trans (le_iSup (fun i => ringKrullDim (A i)) i)

/-- The Krull dimension of a commutative semiring is at most the supremum of the
Krull dimensions of its subsemirings generated by finite subsets. -/
theorem ringKrullDim_le_iSup_closure_finset (B : Type v) [CommSemiring B] :
    ringKrullDim B ≤ ⨆ s : Finset B, ringKrullDim (Subsemiring.closure (s : Set B)) := by
  classical
  apply ringKrullDim_le_iSup_of_finite_subset_range
    (fun s : Finset B => SubsemiringClass.subtype (Subsemiring.closure (s : Set B)))
  intro E hE
  refine ⟨hE.toFinset, fun x hx => ?_⟩
  exact ⟨⟨x, Subsemiring.subset_closure (by simpa using hx)⟩, rfl⟩

/-- If every finite subset of a commutative semiring lies in one homomorphism range,
the dimension of any subsemiring is bounded by the supremum of the dimensions of its
preimages under those homomorphisms. The bound is in `WithBot ℕ∞`, including `⊥` and `⊤`;
no injectivity, directed system, or finite-dimensionality hypothesis is required. -/
theorem ringKrullDim_subsemiring_le_iSup_comap_of_finite_subset_range
    {I : Type u} {R : I → Type v} {S : Type w}
    [∀ i, CommSemiring (R i)] [CommSemiring S]
    (f : ∀ i, R i →+* S) (A : Subsemiring S)
    (hf : ∀ (E : Set S), E.Finite → ∃ i, E ⊆ Set.range (f i)) :
    ringKrullDim A ≤ ⨆ i, ringKrullDim (A.comap (f i)) := by
  apply ringKrullDim_le_iSup_of_finite_subset_range
    (fun i => (f i).restrict (A.comap (f i)) A (fun _ hx => hx))
  intro E hE
  obtain ⟨i, hi⟩ := hf (Subtype.val '' E) (hE.image Subtype.val)
  refine ⟨i, ?_⟩
  rw [RingHom.range_restrict_comap]
  exact Set.image_subset_iff.mp hi
