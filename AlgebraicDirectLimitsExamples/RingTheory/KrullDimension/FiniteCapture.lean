module

public import AlgebraicDirectLimits.RingTheory.KrullDimension.FiniteCapture
public import Mathlib.Algebra.MvPolynomial.CommRing

/-!
# Examples of finite-subset capture

A singleton family of surjective maps recovers the surjective Krull-dimension bound.
Finitely generated subsemirings also give the bound for a polynomial ring with infinitely
many variables, without requiring one finite-generated subsemiring to contain the whole ring.

The empty finite subset rules out an empty index type, even when the target semiring is trivial.
-/

@[expose] public section

universe u v w

namespace FiniteCaptureExamples

/-- The singleton-family specialization is exactly the surjective Krull-dimension bound. -/
theorem surjective_bound_from_finite_capture
    {R : Type u} {S : Type v} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) (hf : Function.Surjective f) : ringKrullDim S ≤ ringKrullDim R := by
  simpa using ringKrullDim_le_iSup_of_finite_subset_range
    (A := fun _ : Unit => R) (fun _ => f)
    (fun E _ => ⟨(), fun x _ => hf x⟩)

/-- Subsemirings generated by finite subsets bound the dimension even with infinitely many
polynomial variables. -/
theorem polynomial_dimension_le_finite_generated_dimensions :
    ringKrullDim (MvPolynomial ℕ ℤ) ≤
      ⨆ s : Finset (MvPolynomial ℕ ℤ),
        ringKrullDim (Subsemiring.closure (s : Set (MvPolynomial ℕ ℤ))) :=
  ringKrullDim_le_iSup_closure_finset _

/-- If all sources are trivial, finite-subset capture forces the target to be trivial.
This uses the bottom-valued dimension bound, without assuming any spectrum is nonempty. -/
theorem subsingleton_of_finite_subset_range_subsingleton
    {I : Type u} {B : Type v} [CommSemiring B]
    {A : I → Type w} [∀ i, CommSemiring (A i)] [∀ i, Subsingleton (A i)]
    (φ : ∀ i, A i →+* B)
    (hfinite : ∀ (E : Set B), E.Finite → ∃ i, E ⊆ Set.range (φ i)) : Subsingleton B := by
  apply ringKrullDim_eq_bot_iff_subsingleton.mp
  apply le_bot_iff.mp
  calc
    ringKrullDim B ≤ ⨆ i, ringKrullDim (A i) :=
      ringKrullDim_le_iSup_of_finite_subset_range φ hfinite
    _ = ⊥ := by simp [ringKrullDim_eq_bot_of_subsingleton]

/-- Capturing the empty subset already forces the family to have an index. -/
theorem nonempty_of_finite_subset_range
    {I : Type u} {B : Type v} [CommSemiring B]
    {A : I → Type w} [∀ i, CommSemiring (A i)]
    (φ : ∀ i, A i →+* B)
    (hfinite : ∀ (E : Set B), E.Finite → ∃ i, E ⊆ Set.range (φ i)) : Nonempty I := by
  obtain ⟨i, _⟩ := hfinite ∅ Set.finite_empty
  exact ⟨i⟩

/-- An empty family cannot satisfy finite-subset capture, including for a trivial target. -/
theorem not_finite_subset_range_of_isEmpty
    {I : Type u} [IsEmpty I] {B : Type v} [CommSemiring B]
    {A : I → Type w} [∀ i, CommSemiring (A i)] (φ : ∀ i, A i →+* B) :
    ¬ (∀ (E : Set B), E.Finite → ∃ i, E ⊆ Set.range (φ i)) := by
  intro hfinite
  obtain ⟨i⟩ := nonempty_of_finite_subset_range φ hfinite
  exact isEmptyElim i

end FiniteCaptureExamples
